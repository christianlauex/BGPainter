<Window x:Class="Backgroundcolourist.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Backgroundcolourist" Height="500" Width="650">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Previews -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Color Desktop Preview -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Background="#F0F0F0" CornerRadius="4">
                <Grid>
                    <Image x:Name="DesktopPreviewImage" Stretch="Uniform" Margin="5"/>
                    <TextBlock x:Name="DesktopPlaceholder" Text="Desktop Preview (Color)" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                </Grid>
            </Border>

            <!-- B&W Lock Screen Preview -->
            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Background="#F0F0F0" CornerRadius="4">
                <Grid>
                    <Image x:Name="LockScreenPreviewImage" Stretch="Uniform" Margin="5"/>
                    <TextBlock x:Name="LockScreenPlaceholder" Text="Lock Screen Preview (B&amp;W)" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="SelectBtn" Content="Select Image" Width="140" Height="35" Click="SelectBtn_Click"/>
            <Button Name="ApplyBtn" Content="Apply Wallpapers" Width="140" Height="35" FontWeight="Bold" 
                    IsEnabled="False" Click="ApplyBtn_Click"/>
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="3" Name="StatusText" Foreground="Green" TextAlignment="Center" Margin="0,15,0,0"/>
    </Grid>
</Window>