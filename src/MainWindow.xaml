<Window x:Class="BGPainter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="650" Width="750" MinHeight="400" MinWidth="500"
        Background="#323437">
    <Window.Resources>
        <!-- Style for corner resize handles -->
        <Style x:Key="ResizeHandleStyle" TargetType="Thumb">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{TemplateBinding Background}" 
                                   Stroke="{TemplateBinding BorderBrush}" 
                                   StrokeThickness="{TemplateBinding BorderThickness}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <!-- Auto-Scaling Preview Canvas Area -->
        <!-- <Border Grid.Row="1" BorderBrush="DarkGray" BorderThickness="1" Background="#1E1E1E" CornerRadius="4"> -->
        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="4">
            <Canvas x:Name="PreviewCanvas" ClipToBounds="True" 
                    Loaded="PreviewCanvas_Loaded" 
                    SizeChanged="PreviewCanvas_SizeChanged">
                
                <Image x:Name="SourceImage" Stretch="Uniform"/>

                <!-- 50% Darkening Overlay Outside Crop Region -->
                <Path x:Name="DimOverlay" Fill="#80000000" Visibility="Collapsed" IsHitTestVisible="False">
                    <Path.Data>
                        <CombinedGeometry GeometryCombineMode="Exclude">
                            <CombinedGeometry.Geometry1>
                                <RectangleGeometry x:Name="FullImageGeo"/>
                            </CombinedGeometry.Geometry1>
                            <CombinedGeometry.Geometry2>
                                <RectangleGeometry x:Name="CropCutoutGeo"/>
                            </CombinedGeometry.Geometry2>
                        </CombinedGeometry>
                    </Path.Data>
                </Path>
                
                <!-- Transparent Crop Window Overlay with White Borders & 3x3 Grid -->
                <Border x:Name="CropWindow" 
                        BorderBrush="White" BorderThickness="2" 
                        Background="Transparent" Cursor="SizeAll"
                        MouseLeftButtonDown="CropWindow_MouseLeftButtonDown"
                        MouseLeftButtonUp="CropWindow_MouseLeftButtonUp"
                        MouseMove="CropWindow_MouseMove" Visibility="Collapsed">
                    <Grid>
                        <!-- 3x3 Grid overlay lines (Rule of Thirds) -->
                        <Grid IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- White Vertical Grid Lines -->
                            <Border Grid.Column="0" Grid.RowSpan="3" BorderBrush="#88FFFFFF" BorderThickness="0,0,1,0"/>
                            <Border Grid.Column="1" Grid.RowSpan="3" BorderBrush="#88FFFFFF" BorderThickness="0,0,1,0"/>

                            <!-- White Horizontal Grid Lines -->
                            <Border Grid.Row="0" Grid.ColumnSpan="3" BorderBrush="#88FFFFFF" BorderThickness="0,0,0,1"/>
                            <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#88FFFFFF" BorderThickness="0,0,0,1"/>
                        </Grid>

                        <!-- Resize Handles on Corners -->
                        <Thumb Style="{StaticResource ResizeHandleStyle}" Cursor="SizeNWSE"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="-5,-5,0,0" DragDelta="TopLeft_DragDelta"/>
                        
                        <Thumb Style="{StaticResource ResizeHandleStyle}" Cursor="SizeNESW"
                               HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,-5,-5,0" DragDelta="TopRight_DragDelta"/>
                        
                        <Thumb Style="{StaticResource ResizeHandleStyle}" Cursor="SizeNESW"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom"
                               Margin="-5,0,0,-5" DragDelta="BottomLeft_DragDelta"/>
                        
                        <Thumb Style="{StaticResource ResizeHandleStyle}" Cursor="SizeNWSE"
                               HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,-5,-5" DragDelta="BottomRight_DragDelta"/>
                    </Grid>
                </Border>
            </Canvas>
        </Border>

        <!-- Actions -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- B&W Lockscreen Live Preview Header & Image -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <!-- <Border BorderBrush="DarkGray" BorderThickness="1" Background="#1E1E1E" CornerRadius="4" Height="120"> -->
                <Border Background="#1E1E1E" CornerRadius="4" Height="120">
                    <Image x:Name="LockscreenPreviewImage" Stretch="Uniform"/>
                </Border>
            </StackPanel>

            <!-- Status Text Area -->
            <TextBlock Grid.Row="2" Name="StatusText" 
                       Foreground="White" TextWrapping="Wrap" 
                       TextAlignment="Left" FontSize="12" Margin="0,0,0,12"/>

            <!-- Vertically Stacked Actions -->
            <StackPanel Grid.Row="3" VerticalAlignment="Top">
                <Button Name="SelectBtn" Content="Upload" 
                        Height="38" Margin="0,0,0,12"
                        Click="SelectBtn_Click"/>
                
                <Button Name="ApplyBtn" Content="Apply" 
                        Height="38" FontWeight="Bold" 
                        IsEnabled="False" Click="ApplyBtn_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>